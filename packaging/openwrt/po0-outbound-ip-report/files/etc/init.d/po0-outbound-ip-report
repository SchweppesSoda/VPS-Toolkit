#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

CONFIG_FILE='/etc/config/po0_outbound_ip_report'

start_service() {
	local enabled
	if [ -e "$CONFIG_FILE" ]; then
		[ -f "$CONFIG_FILE" ] && [ ! -L "$CONFIG_FILE" ] || return 0
		chmod 600 "$CONFIG_FILE" 2>/dev/null || return 0
	fi
	enabled="$(uci -q get po0_outbound_ip_report.main.enabled 2>/dev/null || printf '0')"
	case "$enabled" in
		1|true|yes|on) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/libexec/po0-outbound-ip-report-service
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# Applying UCI starts/reloads the service according to the strict total
	# switch. The package postinst separately handles upgrade recovery.
	procd_add_reload_trigger po0_outbound_ip_report
}
