#!/bin/sh
set -u
umask 077

RUN_DIR='/var/run/po0-outbound-ip-report'
SERVICE='/usr/libexec/po0-outbound-ip-report-service'
HOTPLUG_LOG="${RUN_DIR}/hotplug.log"

prepare_hotplug_log() {
	[ "$(id -u 2>/dev/null || printf '1')" = '0' ] || return 1
	if [ ! -e "$RUN_DIR" ]; then
		mkdir -p "$RUN_DIR" 2>/dev/null || return 1
	fi
	run_dir_meta="$(ls -ldn "$RUN_DIR" 2>/dev/null || true)"
	run_dir_type="$(printf '%s\n' "$run_dir_meta" | awk 'NR == 1 { print substr($1, 1, 1) }')"
	run_dir_owner="$(printf '%s\n' "$run_dir_meta" | awk 'NR == 1 { print $3 }')"
	[ "$run_dir_type" = 'd' ] || return 1
	[ "$run_dir_owner" = '0' ] || return 1
	chmod 700 "$RUN_DIR" 2>/dev/null || return 1
	run_dir_meta="$(ls -ldn "$RUN_DIR" 2>/dev/null || true)"
	run_dir_mode="$(printf '%s\n' "$run_dir_meta" | awk 'NR == 1 { print $1 }')"
	[ "$run_dir_mode" = 'drwx------' ] || return 1
	[ ! -L "$HOTPLUG_LOG" ] || return 1
	if [ ! -e "$HOTPLUG_LOG" ]; then
		: > "$HOTPLUG_LOG" 2>/dev/null || return 1
	fi
	[ -f "$HOTPLUG_LOG" ] || return 1
	chmod 600 "$HOTPLUG_LOG" 2>/dev/null || return 1
	log_meta="$(ls -ldn "$HOTPLUG_LOG" 2>/dev/null || true)"
	log_mode="$(printf '%s\n' "$log_meta" | awk 'NR == 1 { print $1 }')"
	log_owner="$(printf '%s\n' "$log_meta" | awk 'NR == 1 { print $3 }')"
	[ "$log_mode" = '-rw-------' ] && [ "$log_owner" = '0' ]
}

# netifd's ifupdate may describe unrelated data changes. React only to an
# address/route update, or interface recovery; skip loopback.
case "${ACTION:-}" in
	ifup) ;;
	ifupdate) [ "${IFUPDATE_ADDRESSES:-0}" = 1 ] || [ "${IFUPDATE_ROUTES:-0}" = 1 ] || exit 0 ;;
	*) exit 0 ;;
esac
wan="${INTERFACE:-}"
case "$wan" in ''|loopback|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
overall="$(uci -q get po0_outbound_ip_report.main.enabled 2>/dev/null || printf 0)"
case "$overall" in 1|true|yes|on) ;; *) exit 0 ;; esac
probe_mode="$(uci -q get po0_outbound_ip_report.main.probe_mode 2>/dev/null || true)"

lane_matches_event() {
	# Source-address and legacy upstream-probe modes observe only this host's
	# network. They cannot receive an upstream router's WAN hotplug events.
	[ "$probe_mode" = local ] || return 0
	if [ "$lane" = worker ]; then
		wans="$(uci -q get po0_outbound_ip_report.main.wans 2>/dev/null || true)"
		case "$wans" in
			''|all)
				[ "$(uci -q get "mwan3.$wan" 2>/dev/null || true)" = interface ] || return 1
				case "$(uci -q get "mwan3.$wan.enabled" 2>/dev/null || true)" in 0|false|no|off) return 1 ;; esac
				return 0 ;;
		esac
		wans="$(printf '%s' "$wans" | tr ', ' ';;')"
		case ";$wans;" in *";$wan;"*) return 0 ;; *) return 1 ;; esac
	fi
	while IFS= read -r binding; do
		[ -n "$binding" ] || continue
		case "$(uci -q get "po0_outbound_ip_report.${binding}.enabled" 2>/dev/null || true)" in 0|false|no|off) continue ;; esac
		configured_wan="$(uci -q get "po0_outbound_ip_report.${binding}.wan" 2>/dev/null || true)"
		[ "$configured_wan" != "$wan" ] || return 0
	done <<EOF
$(uci -q show po0_outbound_ip_report 2>/dev/null | sed -n 's/^po0_outbound_ip_report\.\([^.=]*\)=official_binding$/\1/p')
EOF
	return 1
}

run_hotplug_attempt() {
	prepare_hotplug_log || return 0
	attempt_log="$(mktemp "$RUN_DIR/hotplug-attempt.XXXXXX" 2>/dev/null || true)"
	[ -n "$attempt_log" ] || return 0
	chmod 600 "$attempt_log" 2>/dev/null || {
		rm -f "$attempt_log" 2>/dev/null || true
		return 0
	}
	if "$SERVICE" "$lane" network "$filter_wan" >"$attempt_log" 2>&1; then
		attempt_rc=0
	else
		attempt_rc=$?
	fi
	# Keep the persistent diagnostic bounded and replace it atomically. The
	# runner emits only redacted, finite status rows; head also caps failures.
	bounded_log="$(mktemp "$RUN_DIR/hotplug-bounded.XXXXXX" 2>/dev/null || true)"
	if [ -z "$bounded_log" ]; then
		rm -f "$attempt_log" 2>/dev/null || true
		return "$attempt_rc"
	fi
	head -c 65536 "$attempt_log" >"$bounded_log" 2>/dev/null || {
		rm -f "$attempt_log" "$bounded_log" 2>/dev/null || true
		return "$attempt_rc"
	}
	chmod 600 "$bounded_log" 2>/dev/null || {
		rm -f "$attempt_log" "$bounded_log" 2>/dev/null || true
		return "$attempt_rc"
	}
	mv -f "$bounded_log" "$HOTPLUG_LOG" 2>/dev/null || {
		rm -f "$attempt_log" "$bounded_log" 2>/dev/null || true
		return "$attempt_rc"
	}
	rm -f "$attempt_log" 2>/dev/null || true
	chmod 600 "$HOTPLUG_LOG" 2>/dev/null || true
	return "$attempt_rc"
}

# Each channel waits/retries independently and rechecks its switch after the
# settling delay. A timer disabled with interval=0 does not suppress events.
for lane in worker official; do
	fallback=0; [ "$lane" != worker ] || fallback=1
	enabled="$(uci -q get "po0_outbound_ip_report.main.${lane}_enabled" 2>/dev/null || printf '%s' "$fallback")"
	case "$enabled" in 0|false|no|off) continue ;; esac
	network="$(uci -q get "po0_outbound_ip_report.main.${lane}_network_enabled" 2>/dev/null || printf 1)"
	case "$network" in 0|false|no|off) continue ;; esac
	lane_matches_event || continue
	filter_wan=''
	[ "$probe_mode" != local ] || [ "$lane" != official ] || filter_wan="$wan"
	(
		HOTPLUG_LOG="${RUN_DIR}/hotplug.${lane}.log"
		sleep 5
		run_hotplug_attempt
	) &
done
exit 0
