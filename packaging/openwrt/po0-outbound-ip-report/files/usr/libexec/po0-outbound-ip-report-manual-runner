#!/bin/sh
set -u

STATE_FILE="${PO0_MANUAL_STATE_FILE:-/tmp/po0-outbound-ip-report-manual.state}"
LOG_FILE="${PO0_MANUAL_LOG_FILE:-/tmp/po0-outbound-ip-report-manual.log}"
PID_FILE="${PO0_MANUAL_PID_FILE:-/tmp/po0-outbound-ip-report-manual.pid}"
REPORT_COMMAND="${PO0_MANUAL_REPORT_COMMAND:-/usr/libexec/po0-outbound-ip-report-uci}"

umask 077
started="$(sed -n 's/^observed_at=//p' "${STATE_FILE}" 2>/dev/null | head -n 1)"
case "${started}" in ''|*[!0-9]*) started="$(date +%s)" ;; esac

tmp_log="${LOG_FILE}.$$"
tmp_state="${STATE_FILE}.$$"
force="${1:-}"

if [ "${force}" = "--force-report" ]; then
    if "${REPORT_COMMAND}" --force-report > "${tmp_log}" 2>&1; then
        rc=0
    else
        rc=$?
    fi
elif "${REPORT_COMMAND}" > "${tmp_log}" 2>&1; then
    rc=0
else
    rc=$?
fi

mv -f "${tmp_log}" "${LOG_FILE}"
{
    printf 'status=finished\n'
    printf 'observed_at=%s\n' "${started}"
    printf 'finished_at=%s\n' "$(date +%s)"
    printf 'exit_code=%s\n' "${rc}"
} > "${tmp_state}"
mv -f "${tmp_state}" "${STATE_FILE}"
rm -f "${PID_FILE}"
exit 0
