#!/bin/sh
set -u
lane="${1:-worker}"
force="${2:-0}"
case "$lane" in worker|official) :;; --force-report) lane=worker; force=1;; *) exit 2;; esac
BASE='/tmp/po0-outbound-ip-report'
STATE_FILE="${PO0_MANUAL_STATE_FILE:-${BASE}.${lane}.manual.state}"
LOG_FILE="${PO0_MANUAL_LOG_FILE:-${BASE}.${lane}.manual.log}"
PID_FILE="${PO0_MANUAL_PID_FILE:-${BASE}.${lane}.manual.pid}"
REPORT_COMMAND="${PO0_MANUAL_REPORT_COMMAND:-/usr/libexec/po0-outbound-ip-report-uci}"
umask 077
started="$(sed -n 's/^observed_at=//p' "$STATE_FILE" 2>/dev/null | head -n 1)"
case "$started" in ''|*[!0-9]*) started="$(date +%s)";; esac
set -- "--${lane}-report"
[ "$force" != 1 ] || set -- "$@" --force-report
if "$REPORT_COMMAND" "$@" > "${LOG_FILE}.$$" 2>&1; then rc=0; else rc=$?; fi
mv -f "${LOG_FILE}.$$" "$LOG_FILE"
{
 printf 'status=finished
lane=%s
observed_at=%s
finished_at=%s
exit_code=%s
' "$lane" "$started" "$(date +%s)" "$rc"
} > "${STATE_FILE}.$$"
mv -f "${STATE_FILE}.$$" "$STATE_FILE"
rm -f "$PID_FILE"
# Use the completed manual run as the latest attempt for this channel too.
# Reapplying its saved automatic switch must not immediately repeat the run.
if [ -z "${PO0_MANUAL_REPORT_COMMAND:-}" ]; then
 cp -f "$STATE_FILE" "${BASE}.${lane}.state"
 cp -f "$LOG_FILE" "${BASE}.${lane}.log"
 /etc/init.d/po0-outbound-ip-report restart >/dev/null 2>&1 || true
fi
exit 0
