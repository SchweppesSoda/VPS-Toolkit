#!/bin/sh
set -u
umask 077

BASE='/tmp/po0-outbound-ip-report'
UCI_RUNNER='/usr/libexec/po0-outbound-ip-report-uci'
lane="${1:-}"
trigger="${2:-timer}"
wan="${3:-}"
case "$lane" in worker|official) ;; *) exit 2 ;; esac
case "$trigger" in timer|network) ;; *) exit 2 ;; esac
case "$wan" in *[!A-Za-z0-9_.-]*) exit 2 ;; esac
LOG="${BASE}.${lane}.log"
STATE="${BASE}.${lane}.state"
TIMER_STATE="${BASE}.${lane}.timer.state"

is_disabled() {
	case "${1:-}" in 0|false|no|off) return 0 ;; *) return 1 ;; esac
}

uci_get() { uci -q get "po0_outbound_ip_report.main.$1" 2>/dev/null || true; }

interval_for() {
	case "$lane" in worker) key=interval_seconds; fallback=3600 ;; official) key=official_interval_seconds; fallback=600 ;; esac
	value="$(uci_get "$key")"
	case "$value" in ''|*[!0-9]*) value="$fallback" ;; esac
	value="$(printf '%s' "$value" | sed 's/^0*//')"
	[ -n "$value" ] || value=0
	# Zero disables only the timer. Preserve legacy positive values below 60.
	[ "$value" = 0 ] || [ "$value" -ge 60 ] 2>/dev/null || value=60
	printf '%s' "$value"
}

automatic_enabled() {
	overall="$(uci_get enabled)"
	case "$overall" in 1|true|yes|on) ;; *) return 1 ;; esac
	enabled="$(uci_get "${lane}_enabled")"
	[ -n "$enabled" ] || { [ "$lane" = worker ] && enabled=1 || enabled=0; }
	is_disabled "$enabled" && return 1
	if [ "$trigger" = network ]; then
		! is_disabled "$(uci_get "${lane}_network_enabled")"
	else
		! is_disabled "$(uci_get "${lane}_timer_enabled")" && [ "$(interval_for)" -gt 0 ]
	fi
}

read_timer_time() {
	file="$TIMER_STATE"
	# Seed from the previous APK's result without rewriting the saved switches.
	if [ ! -r "$file" ] && [ -r "$STATE" ] && ! grep -q '^trigger=network$' "$STATE"; then file="$STATE"; fi
	case "$lane" in worker) field=finished_at ;; official) field=observed_at ;; esac
	value=''
	[ ! -r "$file" ] || value="$(sed -n "s/^${field}=//p" "$file" | head -n 1)"
	case "$value" in ''|*[!0-9]*) value=0 ;; esac
	printf '%s' "$value"
}

seconds_until_due() {
	last="$(read_timer_time)"
	now="$(date +%s)"
	interval="$(interval_for)"
	if [ "$last" -eq 0 ] || [ "$now" -lt "$last" ] || [ $((now - last)) -ge "$interval" ]; then
		printf '0'
	else
		printf '%s' "$((interval - now + last))"
	fi
}

run_lane() {
	started="$(date +%s)"
	tmp_log="${LOG}.$$"
	set -- "--${lane}-only"
	if [ "$trigger" = network ]; then
		set -- "$@" --network-changed
		[ "$lane" != official ] || [ -z "$wan" ] || set -- "$@" --official-wan "$wan"
	else
		set -- "$@" --timer-trigger
	fi
	"$UCI_RUNNER" "$@" > "$tmp_log" 2>&1 && rc=0 || rc=$?
	# A busy run has not reported. Keep its prior deadline and visible result.
	if [ "$rc" -eq 75 ]; then rm -f "$tmp_log"; return 75; fi
	# Preserve a legacy timer deadline before an event replaces the old result.
	if [ "$trigger" = network ] && [ ! -r "$TIMER_STATE" ] && [ -r "$STATE" ] && ! grep -q '^trigger=network$' "$STATE"; then
		cp -f "$STATE" "${TIMER_STATE}.$$"
		mv -f "${TIMER_STATE}.$$" "$TIMER_STATE"
	fi
	mv -f "$tmp_log" "$LOG"
	finished="$(date +%s)"
	tmp_state="${STATE}.$$"
	{
		printf 'status=finished\n'
		printf 'lane=%s\n' "$lane"
		printf 'trigger=%s\n' "$trigger"
		printf 'observed_at=%s\n' "$started"
		printf 'finished_at=%s\n' "$finished"
		printf 'exit_code=%s\n' "$rc"
	} > "$tmp_state"
	if [ "$trigger" = timer ]; then
		cp -f "$tmp_state" "${TIMER_STATE}.$$"
		mv -f "${TIMER_STATE}.$$" "$TIMER_STATE"
	fi
	mv -f "$tmp_state" "$STATE"
	chmod 600 "$LOG" "$STATE" 2>/dev/null || true
	return "$rc"
}

if [ "$trigger" = network ]; then
	# Coalesce same-channel activity, then retry the event so a WAN change is
	# not lost behind a manual/timer run. Never wake the other channel.
	attempt=0
	while automatic_enabled; do
		run_lane && exit 0 || rc=$?
		[ "$rc" -eq 75 ] && [ "$attempt" -lt 40 ] || exit "$rc"
		attempt=$((attempt + 1))
		sleep 3
	done
	exit 0
fi

while automatic_enabled; do
	remaining="$(seconds_until_due)"
	if [ "$remaining" -eq 0 ]; then
		run_lane || { [ "$?" -ne 75 ] || { sleep 3; continue; }; }
		remaining="$(seconds_until_due)"
		[ "$remaining" -gt 0 ] || remaining=1
	fi
	sleep "$remaining"
done
