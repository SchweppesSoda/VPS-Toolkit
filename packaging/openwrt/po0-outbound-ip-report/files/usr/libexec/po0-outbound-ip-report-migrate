#!/bin/sh
set -eu
umask 077
config='/etc/config/po0_outbound_ip_report'
backup='/usr/lib/po0/legacy/official-only-v1'
[ -f "$config" ] && [ ! -L "$config" ] || exit 1
[ ! -L "$backup" ] || exit 1
mkdir -p "$backup"
chmod 700 "$backup"
if [ ! -e "$backup/config" ]; then
    cp -p "$config" "$backup/config"
    chmod 600 "$backup/config"
fi
# Delete only retired keys; official targets, bindings, source addresses,
# enabled/paused choices and the saved official interval remain byte-for-byte
# equivalent in UCI. Repeated execution is safe after a partially failed run.
for key in worker_enabled worker_url worker_name source_id identity secret allow_http wans interval_seconds worker_timer_enabled worker_network_enabled skip_wifi_ssids; do
    if uci -q get "po0_outbound_ip_report.main.$key" >/dev/null 2>&1; then
        uci -q delete "po0_outbound_ip_report.main.$key"
    fi
done
if [ "$(uci -q get po0_outbound_ip_report.main.probe_mode || true)" = source ]; then
    for key in router_probe_url direct_probe_resolve; do
        if uci -q get "po0_outbound_ip_report.main.$key" >/dev/null 2>&1; then uci -q delete "po0_outbound_ip_report.main.$key"; fi
    done
fi
uci commit po0_outbound_ip_report
chmod 600 "$config"
printf '1\n' > "$backup/completed"
