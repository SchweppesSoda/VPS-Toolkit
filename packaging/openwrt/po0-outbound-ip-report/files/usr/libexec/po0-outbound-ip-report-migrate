#!/bin/sh
set -u

legacy_dir="/etc/po0-outbound-ip-report"
legacy_config="${legacy_dir}/settings.env"
backup_dir="/usr/lib/po0/legacy"

mkdir -p "${backup_dir}"
if [ -x /usr/local/sbin/po0-outbound-ip-report ] && [ ! -e "${backup_dir}/po0-outbound-ip-report.pre-apk" ]; then
    cp -p /usr/local/sbin/po0-outbound-ip-report "${backup_dir}/po0-outbound-ip-report.pre-apk" 2>/dev/null || true
fi

if [ -r "${legacy_config}" ] && [ ! -e "${backup_dir}/settings.env.pre-apk" ]; then
    cp -p "${legacy_config}" "${backup_dir}/settings.env.pre-apk" 2>/dev/null || true
    # This file was generated by po0-outbound-ip-report with shell-quoted assignments.
    # shellcheck disable=SC1090
    . "${legacy_config}" || true
    [ -n "${WORKER_URL:-}" ] && uci set "po0_outbound_ip_report.main.worker_url=${WORKER_URL}"
    [ -n "${SOURCE_ID:-}" ] && uci set "po0_outbound_ip_report.main.source_id=${SOURCE_ID}"
    [ -n "${IDENTITY:-}" ] && uci set "po0_outbound_ip_report.main.identity=${IDENTITY}"
    [ -n "${SECRET:-}" ] && uci set "po0_outbound_ip_report.main.secret=${SECRET}"
    [ -n "${ALLOW_HTTP:-}" ] && uci set "po0_outbound_ip_report.main.allow_http=${ALLOW_HTTP}"
    [ -n "${ROUTER_PROBE_URL:-}" ] && uci set "po0_outbound_ip_report.main.router_probe_url=${ROUTER_PROBE_URL}"
    [ -n "${WANS:-}" ] && uci set "po0_outbound_ip_report.main.wans=${WANS}"
    [ -n "${IP_CHECK_URLS:-}" ] && uci set "po0_outbound_ip_report.main.ip_check_urls=${IP_CHECK_URLS}"
    [ -n "${SKIP_WIFI_SSIDS:-}" ] && uci set "po0_outbound_ip_report.main.skip_wifi_ssids=${SKIP_WIFI_SSIDS}"
    [ -n "${INTERVAL_SECONDS:-}" ] && uci set "po0_outbound_ip_report.main.interval_seconds=${INTERVAL_SECONDS}"
    uci set po0_outbound_ip_report.main.enabled='1'
    uci commit po0_outbound_ip_report
fi

if [ -r /etc/crontabs/root ] && grep -q 'OUTBOUND_IP_REPORT_BEGIN' /etc/crontabs/root; then
    [ -e "${backup_dir}/root.crontab.pre-apk" ] || cp -p /etc/crontabs/root "${backup_dir}/root.crontab.pre-apk"
    awk '
        /# OUTBOUND_IP_REPORT_BEGIN/ { managed=1; next }
        /# OUTBOUND_IP_REPORT_END/ { managed=0; next }
        !managed { print }
    ' /etc/crontabs/root > /etc/crontabs/root.po0-apk.tmp && mv /etc/crontabs/root.po0-apk.tmp /etc/crontabs/root
    /etc/init.d/cron reload >/dev/null 2>&1 || true
fi

changed=0
if ! uci -q get po0_outbound_ip_report.main.worker_enabled >/dev/null 2>&1; then
	uci set po0_outbound_ip_report.main.worker_enabled='1'
	changed=1
fi
if ! uci -q get po0_outbound_ip_report.main.official_enabled >/dev/null 2>&1; then
	uci set po0_outbound_ip_report.main.official_enabled='0'
	changed=1
fi

# Source mode resolves and probes on this gateway. Do not restore a retired
# upstream CGI or a fixed probe server address during package upgrades.
if [ "$(uci -q get po0_outbound_ip_report.main.probe_mode 2>/dev/null || true)" = 'source' ]; then
    for option in router_probe_url direct_probe_resolve; do
        if uci -q get "po0_outbound_ip_report.main.${option}" >/dev/null 2>&1; then
            uci -q delete "po0_outbound_ip_report.main.${option}" || exit 1
            changed=1
        fi
    done
    if [ -z "$(uci -q get po0_outbound_ip_report.main.probe_dns_server 2>/dev/null || true)" ]; then
        uci set po0_outbound_ip_report.main.probe_dns_server='192.168.88.1' || exit 1
        changed=1
    fi
fi

# The official channel cadence is a package safety constant. Remove the old
# free-form option so an upgrade cannot leave a misleading setting behind.
if uci -q get po0_outbound_ip_report.main.official_interval_seconds >/dev/null 2>&1; then
	uci -q delete po0_outbound_ip_report.main.official_interval_seconds || true
	changed=1
fi
[ "$changed" = '1' ] && uci commit po0_outbound_ip_report
chmod 600 /etc/config/po0_outbound_ip_report 2>/dev/null || true
chmod 0700 /usr/libexec/po0-outbound-ip-report-uci /usr/libexec/po0-official-firewall-request /usr/libexec/po0-official-firewall-runner 2>/dev/null || true
exit 0
