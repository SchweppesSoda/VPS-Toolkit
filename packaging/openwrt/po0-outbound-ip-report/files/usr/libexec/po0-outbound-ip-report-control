#!/bin/sh
set -u
BASE='/tmp/po0-outbound-ip-report'
MANUAL_RUNNER='/usr/libexec/po0-outbound-ip-report-manual-runner'
action="${1:-status}"
lane='worker'
case "$action" in official-*) lane='official';; esac
STATE="${BASE}.${lane}.manual.state"
LOG="${BASE}.${lane}.manual.log"
PID="${BASE}.${lane}.manual.pid"
AUTO_STATE="${BASE}.${lane}.state"
AUTO_LOG="${BASE}.${lane}.log"
print_pair() {
 [ ! -r "$1" ] || cat "$1"
 printf '
'
 [ ! -r "$2" ] || cat "$2"
}
stamp() {
 value=$(sed -n 's/^observed_at=//p' "$1" 2>/dev/null | head -n 1)
 case "$value" in ''|*[!0-9]*) value=0;; esac
 printf '%s' "$value"
}
start_manual() {
 if [ -s "$PID" ]; then
  pid=$(cat "$PID")
  case "$pid" in ''|*[!0-9]*) :;; *) if kill -0 "$pid" 2>/dev/null; then print_pair "$STATE" "$LOG"; return 0; fi;; esac
 fi
 umask 077
 printf 'status=running
lane=%s
observed_at=%s
' "$lane" "$(date +%s)" > "$STATE"
 : > "$LOG"
 /sbin/start-stop-daemon -S -b -m -p "$PID" -x "$MANUAL_RUNNER" -- "$lane" "${1:-0}" || {
  printf 'status=finished
lane=%s
exit_code=1
' "$lane" > "$STATE"
  printf '无法启动后台上报。
' > "$LOG"
  return 1
 }
 cat "$STATE"
}
case "$action" in
 worker-report|test-start) start_manual 0;;
 worker-force-report|test-force-start) start_manual 1;;
 official-report) start_manual 0;;
 official-force-report) start_manual 1;;
 worker-progress|official-progress|test-status)
  if [ -r "$STATE" ]; then print_pair "$STATE" "$LOG"; else printf 'status=idle
'; fi;;
 worker-result|official-result|status)
  if [ "$(stamp "$STATE")" -gt 0 ] && [ "$(stamp "$STATE")" -ge "$(stamp "$AUTO_STATE")" ]; then
   print_pair "$STATE" "$LOG"
  elif [ -r "$AUTO_STATE" ]; then print_pair "$AUTO_STATE" "$AUTO_LOG"
  else printf 'status=idle
'; fi;;
 worker-clear|official-clear)
  uci set "po0_outbound_ip_report.main.${lane}_enabled=0" || exit 1
  if [ "$lane" = worker ]; then
   for key in worker_url secret worker_name; do uci -q delete "po0_outbound_ip_report.main.$key" || true; done
  else
   sections="$(uci -q show po0_outbound_ip_report | sed -n 's/^po0_outbound_ip_report\.\([^.=]*\)=official_\(target\|binding\)$/\1/p')"
   for section in $sections; do uci -q delete "po0_outbound_ip_report.$section" || exit 1; done
  fi
  uci commit po0_outbound_ip_report || exit 1
  /etc/init.d/po0-outbound-ip-report reload
  printf '所选通道配置已清除，自动上报已停用；另一通道配置、任务和最近结果保留。\n';;
 official-status) exec /usr/libexec/po0-outbound-ip-report-uci --official-status;;
 discover-wans)
  mode=$(uci -q get po0_outbound_ip_report.main.probe_mode || printf 'router')
  if [ "$mode" = source ]; then
   for wan in wan1 wan2; do
    [ -z "$(uci -q get "po0_outbound_ip_report.main.official_source_$wan")" ] || printf '%s
' "$wan"
   done
  elif [ "$mode" = local ]; then
   uci -q show mwan3 | sed -n 's/^mwan3\.\([^.=]*\)=interface$/\1/p'
  else
   url=$(uci -q get po0_outbound_ip_report.main.router_probe_url || true)
   [ -n "$url" ] || { printf '请填写主路由探针地址。
' >&2; exit 1; }
   curl -4 -fsS --connect-timeout 5 --max-time 30 "$url?wan=list"
  fi;;
 reload) exec /etc/init.d/po0-outbound-ip-report reload;;
 *) printf '未知操作。
' >&2; exit 2;;
esac
