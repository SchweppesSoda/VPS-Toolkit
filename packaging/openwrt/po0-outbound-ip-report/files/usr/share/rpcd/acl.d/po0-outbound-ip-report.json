{
  "po0-outbound-ip-report": {
    "description": "Manage the PO0 outbound IPv4 reporter and official firewall bindings",
    "read": {
      "uci": [ "po0_outbound_ip_report" ],
      "ubus": { "file": [ "exec" ], "service": [ "list" ] }
    },
    "write": {
      "uci": [ "po0_outbound_ip_report" ],
      "ubus": { "file": [ "exec" ], "service": [ "set" ], "uci": [ "commit" ] }
    }
  }
}
