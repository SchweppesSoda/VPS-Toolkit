#!/bin/sh
set -u

action="${1:-test}"
case "${action}" in
    test)
        allowed="$(uci -q get po0_wan_probe.main.allowed_source 2>/dev/null || printf '192.168.88.2')"
        set -- ${allowed}
        REQUEST_METHOD=GET REMOTE_ADDR="${1:-192.168.88.2}" QUERY_STRING='wan=all' \
            /www/cgi-bin/po0-wan-probe
        ;;
    version)
        grep -m1 '^SCRIPT_VERSION=' /www/cgi-bin/po0-wan-probe 2>/dev/null || true
        ;;
    *)
        printf 'unsupported action\n' >&2
        exit 2
        ;;
esac

