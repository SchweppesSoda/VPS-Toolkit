#!name = PO0 LAN Report
#!desc = Reports the current public IPv4 to the existing PO0 LAN Worker and, when configured, the official PO0 firewall. Scheduled official checks are every 10 minutes; home and unknown SSIDs fail closed.
#!author = ProxyConfig
#!system = iOS,iPadOS
#!loon_version = 3.5.0(969)
#!tag = Network,PO0
#!arguments-desc = Set the Worker URL/token as before. Optionally set PO0_FIREWALL_TOKENS to comma-separated pgnfw_... values, with an optional @0..@4 fixed slot; the same token may only appear once even with different slot hints to avoid concurrent account races; use - to clear it. Paste the complete pgnfw_ token. Each device keeps its own saved token/slot; synced input changes do not overwrite it. After editing inputs, run 官方防火墙 · 保存本机设置 on that device. Slot @0..@4 corresponds to slots 1..5; assign different devices different slots.

[Argument]
# ── 自建 PO0 · LAN Worker 参数 ──
po0_worker_url = input,tag=【自建 PO0】Worker 地址,desc=HTTPS /stash-report/v1 接收地址；留空兼容本机旧设置
po0_worker_token = input,tag=【自建 PO0】Worker 密钥,desc=LAN Worker 上报密钥；与官方 Token 分开填写

# ── 官方防火墙参数 ──
PO0_FIREWALL_TOKENS = input,tag=【官方防火墙】Token / 槽位,desc=填写完整 pgnfw_ Token；可带 @0..@4；填写后运行“官方防火墙 · 保存本机设置”；固定每 600 秒检查

[Script]
cron "*/10 * * * *" script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=300,tag=通用 · 自动上报,argument=[{po0_worker_url},{po0_worker_token}],enable=true
network-changed script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=300,tag=通用 · 网络变化上报,argument=[{po0_worker_url},{po0_worker_token}],enable=true
generic script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=300,tag=通用 · 查看上报状态,argument=[{po0_worker_url},{po0_worker_token}],img-url=antenna.radiowaves.left.and.right.system,enable=true
generic script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=300,tag=通用 · 立即上报,argument=[{po0_worker_url},{po0_worker_token}],img-url=arrow.clockwise.circle.system,enable=true

generic script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=10,tag=官方防火墙 · 保存本机设置,argument=[{PO0_FIREWALL_TOKENS}],img-url=square.and.arrow.down.system,enable=true
generic script-path=https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/loon/po0-loon-report.js?rev=20260905-v7,timeout=10,tag=官方防火墙 · 清除本机设置,argument="clear-official",img-url=trash.system,enable=true
