# Copy to /etc/po0/stash-loopback-receiver.env and chmod 600.
# Never commit real values.
PO0_STASH_RECEIVER_SECRET=CHANGE_ME_RECEIVER_BEARER
PO0_STASH_REPORT_TOKEN=CHANGE_ME_SSH_REPORT_TOKEN
PO0_STASH_REPORT_IDENTITY=stash-ssh-poc
PO0_STASH_REPORT_TTL=43200
PO0_MANAGER=/root/nftables-relay-manager.sh
