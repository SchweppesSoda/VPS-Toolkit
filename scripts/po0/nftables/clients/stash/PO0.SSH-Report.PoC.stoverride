name: PO0 SSH 上报（备用 PoC，默认关闭）
desc: |-
  Stash 用 SSH 代理访问 PO0 的 127.0.0.1:8790 receiver。
  只在正式 LAN Worker 链路不可用时测试。替换 SSH 节点、receiver secret 和 source_id。
  可选 PO0_FIREWALL_TOKENS（逗号分隔，可写 token@0..4；同一 token 即使写不同槽位也只能出现一次；填 - 可清空）会复用同一官方直连通道。
  点击状态 Tile 或访问 http://po0-ssh-report.invalid/status 只读检查（不会加白）；访问 /report-now 才是手动上报，仍会先 GET 再按需加白。

proxies:
  - name: PO0 SSH Reporter
    type: ssh
    server: CHANGE_ME_PO0_HOST
    port: 22
    user: stash-report
    private-key: |-
      -----BEGIN OPENSSH PRIVATE KEY-----
      CHANGE_ME_PRIVATE_KEY
      -----END OPENSSH PRIVATE KEY-----
    benchmark-disabled: true

script-providers:
  po0-stash-report-ssh-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/stash/po0-stash-report.js?rev=20260905-v5
    interval: 86400
  po0-stash-status-ssh-tile-v2:
    interval: 86400
    payload: |
      const key = "proxyconfig.po0.stash-report.v1";
      const statusUrl = "http://po0-ssh-report.invalid/status";
      const clean = (value, limit) => String(typeof value === "string" || typeof value === "number" ? value : "-").replace(/pgnfw_[A-Za-z0-9._~-]+/g, "[REDACTED]").replace(/Bearer\s+[^\s,;]+/gi, "Bearer [REDACTED]").replace(/\s+/g, " ").slice(0, limit);
      let state = {};
      try { state = JSON.parse($persistentStore.read(key) || "{}") || {}; } catch (_) {}
      const official = state.official && Array.isArray(state.official.accounts) ? state.official : {};
      const officialAccounts = Array.isArray(official.accounts) ? official.accounts : [];
      const officialOk = officialAccounts.filter((item) => item.status !== "error").length;
      const officialText = officialAccounts.length ? `官方 ${officialOk}/${officialAccounts.length}` : "官方未启用";
      const acceptedAt = Number(state.accepted_at);
      if (!Number.isFinite(acceptedAt) || acceptedAt <= 0) {
        $done({ title: officialAccounts.length ? "PO0 SSH 官方状态" : "PO0 SSH v2 未上报", content: `${officialText}\n${clean(state.last_error || "等待首次定时任务", 80)}`, icon: "terminal.fill", backgroundColor: "#6b7280", url: statusUrl });
      } else {
        const expiresAt = Number(state.expires_at);
        const remaining = Number.isFinite(expiresAt)
          ? Math.max(0, Math.min(99999, Math.floor((expiresAt * 1000 - Date.now()) / 60000)))
          : 0;
        const age = Math.max(0, Math.min(99999, Math.floor((Date.now() - acceptedAt * 1000) / 60000)));
        const cidr = clean(state.accepted_cidr || state.ip, 45);
        const error = state.last_error ? clean(state.last_error, 80) : "";
        $done({
          title: error ? "PO0 SSH v2 上报异常" : remaining > 0 ? "PO0 SSH v2 已上报" : "PO0 SSH v2 已过期",
          content: error ? `${cidr}\n${error}\n${officialText}` : `${cidr}\n${clean(state.network, 12)} · ${age} 分钟前 · 剩余 ${remaining} 分钟\n${officialText}`,
          icon: error || remaining <= 0 ? "exclamationmark.triangle.fill" : "checkmark.shield.fill",
          backgroundColor: error || remaining <= 0 ? "#b45309" : "#178f55",
          url: statusUrl,
        });
      }

cron:
  script:
    - name: po0-stash-report-ssh-worker-v2
      cron: '*/10 * * * *'
      timeout: 90
      argument: '{"mode":"auto","worker_url":"http://127.0.0.1:8790/stash-report/v1","source_id":"iphone-stash-ssh","secret":"CHANGE_ME_RECEIVER_BEARER","selected_proxy":"PO0 SSH Reporter","allow_loopback_http":true,"PO0_FIREWALL_TOKENS":""}'

tiles:
  - name: po0-stash-status-ssh-tile-v2
    interval: 600
    title: PO0 SSH v2 PoC
    content: 默认关闭
    icon: terminal.fill
    backgroundColor: '#6b7280'
    url: http://po0-ssh-report.invalid/status

http:
  force-http-engine:
    - po0-ssh-report.invalid:80
  script:
    - match: ^http://po0-ssh-report\.invalid/report-now(?:\?.*)?$
      name: po0-stash-report-ssh-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force","worker_url":"http://127.0.0.1:8790/stash-report/v1","source_id":"iphone-stash-ssh","secret":"CHANGE_ME_RECEIVER_BEARER","selected_proxy":"PO0 SSH Reporter","allow_loopback_http":true,"PO0_FIREWALL_TOKENS":""}'
    - match: ^http://po0-ssh-report\.invalid/status(?:\?.*)?$
      name: po0-stash-report-ssh-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"status","worker_url":"http://127.0.0.1:8790/stash-report/v1","source_id":"iphone-stash-ssh","secret":"CHANGE_ME_RECEIVER_BEARER","selected_proxy":"PO0 SSH Reporter","allow_loopback_http":true,"PO0_FIREWALL_TOKENS":""}'
