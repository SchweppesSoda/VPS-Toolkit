name: PO0 LAN Worker 上报（正式）
desc: |-
  默认启用。每 10 分钟检查；IP 或网络变化立即上报，未变化每小时续期。
  蜂窝按 /24，普通 Wi-Fi 按 /32。点击 Tile 可强制上报。
  v2 Tile 使用内联只读渲染器，不加载或执行远端上报 worker。
  使用前只需替换两处相同 JSON 中的 worker_url、source_id、secret。

script-providers:
  po0-stash-report-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/stash/po0-stash-report.js?rev=20260721-v2
    interval: 86400
  po0-stash-status-tile-v2:
    interval: 86400
    payload: |
      const key = "proxyconfig.po0.stash-report.v1";
      const forceUrl = "http://po0-report.invalid/report-now";
      const clean = (value, limit) => String(typeof value === "string" || typeof value === "number" ? value : "-").replace(/\s+/g, " ").slice(0, limit);
      let state = {};
      try { state = JSON.parse($persistentStore.read(key) || "{}") || {}; } catch (_) {}
      const acceptedAt = Number(state.accepted_at);
      if (!Number.isFinite(acceptedAt) || acceptedAt <= 0) {
        $done({
          title: "PO0 v2 未上报",
          content: clean(state.last_error || "等待首次定时任务", 80),
          icon: "antenna.radiowaves.left.and.right",
          backgroundColor: "#6b7280",
          url: forceUrl,
        });
      } else {
        const expiresAt = Number(state.expires_at);
        const remaining = Number.isFinite(expiresAt)
          ? Math.max(0, Math.min(99999, Math.floor((expiresAt * 1000 - Date.now()) / 60000)))
          : 0;
        const age = Math.max(0, Math.min(99999, Math.floor((Date.now() - acceptedAt * 1000) / 60000)));
        const cidr = clean(state.accepted_cidr || state.ip, 45);
        const error = state.last_error ? clean(state.last_error, 80) : "";
        $done({
          title: error ? "PO0 v2 上报异常" : remaining > 0 ? "PO0 v2 已上报" : "PO0 v2 已过期",
          content: error ? `${cidr}\n${error}` : `${cidr}\n${clean(state.network, 12)} · ${age} 分钟前 · 剩余 ${remaining} 分钟`,
          icon: error || remaining <= 0 ? "exclamationmark.triangle.fill" : "checkmark.shield.fill",
          backgroundColor: error || remaining <= 0 ? "#b45309" : "#178f55",
          url: forceUrl,
        });
      }

cron:
  script:
    - name: po0-stash-report-worker-v2
      cron: '*/10 * * * *'
      timeout: 15
      argument: '{"mode":"auto","worker_url":"https://CHANGE_ME/stash-report/v1","source_id":"iphone-stash","secret":"CHANGE_ME_BEARER","selected_proxy":"DIRECT"}'

tiles:
  - name: po0-stash-status-tile-v2
    interval: 600
    title: PO0 v2 未上报
    content: 等待首次定时任务
    icon: antenna.radiowaves.left.and.right
    backgroundColor: '#6b7280'
    url: http://po0-report.invalid/report-now

http:
  force-http-engine:
    - po0-report.invalid:80
  script:
    - match: ^http://po0-report\.invalid/report-now(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 15
      argument: '{"mode":"force","worker_url":"https://CHANGE_ME/stash-report/v1","source_id":"iphone-stash","secret":"CHANGE_ME_BEARER","selected_proxy":"DIRECT"}'
