name: PO0 官方防火墙
desc: |-
  访问 http://po0-report.invalid/settings 打开本机管理页。
  【官方防火墙】只在 /save-official 参数填写 Token / 槽位和名称，然后访问 /save-official 保存。
  可以停用、恢复、清除或立即上报；停用保留参数，清除后同步参数不会自动恢复。
  多个官方 Token 支持逗号、分号、空格或换行（JSON 内用 \n）；名称按 Token 顺序，用分号或换行分隔。
  每分钟轮询直连出口 IPv4，变化时上报；官方定期上报，上报间隔默认 600 秒；关闭开关保留原间隔，旧值 0 继续表示关闭。Stash 没有公开原生网络变化事件。
  按网络选择默认关闭；将 /save-official 的 OFFICIAL_NETWORK_TARGETS_ENABLED 设为 true 并填写 PO0_FIREWALL_WIFI_TOKENS 后保存。
  开启后原目标用于蜂窝（5G/4G），Wi-Fi 使用另填的目标；沿用 Token 列表写法，槽位由你填写。
  /recent 查看最近结果，/status 查询官方白名单；/report 立即上报，/report-now 强制官方上报；官方始终先 GET，缺失时才加白。
  Stash 公开 JS 接口不提供当前 SSID，没有可配置的 SSID 跳过名单。

# 内部网络探测，不承载正常流量。两条探测必须恰好一条成功。
proxy-groups:
  - name: 📡 PO0 Wi-Fi 探测
    type: select
    icon: https://raw.githubusercontent.com/Orz-3/mini/master/Color/Urltest.png
    proxies: [REJECT, DIRECT]
    ssid-policy:
      default: DIRECT
      cellular: REJECT
  - name: 📡 PO0 蜂窝探测
    type: select
    icon: https://raw.githubusercontent.com/Orz-3/mini/master/Color/Urltest.png
    proxies: [REJECT, DIRECT]
    ssid-policy:
      default: REJECT
      cellular: DIRECT

script-providers:
  po0-stash-report-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/stash/po0-stash-report.js?rev=20260908-official-only-v1
    interval: 86400
  po0-stash-status-tile-v2:
    interval: 86400
    payload: |
      const key="proxyconfig.po0.stash-report.v1";
      const clean=(v,n)=>String(typeof v==="string"||typeof v==="number"?v:"-").replace(/pgnfw_[A-Za-z0-9._~-]+/g,"[REDACTED]").replace(/Bearer\s+[^\s,;]+/gi,"Bearer [REDACTED]").replace(/\s+/g," ").slice(0,n);
      let state={},settings={};
      try{state=JSON.parse($persistentStore.read(key)||"{}")||{};}catch(_){}
      try{settings=JSON.parse($persistentStore.read(key+".channel-settings")||"{}")||{};}catch(_){}
      const official=state.official||{},accounts=Array.isArray(official.accounts)?official.accounts.filter(x=>x&&typeof x==="object"):[];
      const ok=accounts.filter(x=>x&&x.status!=="error").length;
      const summary=accounts.length?"官方 "+ok+"/"+accounts.length+(official.network?" · "+clean(official.network,12):""):"官方未配置";
      const error=official.last_error?clean(official.last_error,70):"";
      const paused=settings.officialAutoEnabled===false?" · 自动停用":"";
      const names=String(settings.officialNames||"").split(/[;；\n]/);
      const rows=accounts.slice(0,2).map((x,i)=>clean(x.name||names[i]||"账号 "+(i+1),18)+" · "+clean(x.current||x.current_ip||x.ip||"待检查",30));
      $done({title:"PO0 官方防火墙",content:summary+paused+"\n"+(error||rows.join("\n")||"点击保存本机官方配置"),icon:error?"exclamationmark.triangle.fill":"checkmark.shield.fill",backgroundColor:error?"#b45309":accounts.length?"#178f55":"#6b7280",url:"http://po0-report.invalid/settings"});


# ── 公共自动触发 · 读取本机官方配置 ──
cron:
  script:
    - name: po0-stash-report-worker-v2
      cron: '* * * * *'
      timeout: 90
      argument: '{"mode":"auto"}'

tiles:
  - name: po0-stash-status-tile-v2
    interval: 600
    title: PO0 官方防火墙
    content: 点击保存本机官方配置
    icon: antenna.radiowaves.left.and.right
    backgroundColor: '#6b7280'
    url: http://po0-report.invalid/settings

http:
  force-http-engine:
    - po0-report.invalid:80
  script:
    - match: ^http://po0-report\.invalid/report-now(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force"}'
    - match: ^http://po0-report\.invalid/status(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"status"}'

    # ── 官方防火墙参数 · 仅在这里填写 Token / 槽位 ──
    # 上报间隔默认 600 秒，可改为 60..86400；独立定期开关关闭后保留间隔与出口检测；保存不发起上报。
    # script-providers.interval 为脚本更新间隔；cron 每 60 秒检测出口变化。
    - match: ^http://po0-report\.invalid/save-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"save-official","PO0_FIREWALL_TOKENS":"","PO0_FIREWALL_NAMES":"","official_report_interval_seconds":600,"official_timer_enabled":true,"OFFICIAL_NETWORK_TARGETS_ENABLED":false,"PO0_FIREWALL_WIFI_TOKENS":"","PO0_FIREWALL_WIFI_NAMES":""}'
    - match: ^http://po0-report\.invalid/clear-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"clear-official"}'

    # ── 官方与公共操作 ──
    - match: ^http://po0-report\.invalid/toggle-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"toggle-official"}'
    - match: ^http://po0-report\.invalid/official-now$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"report","channel":"official"}'
    - match: ^http://po0-report\.invalid/settings$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"settings"}'
    - match: ^http://po0-report\.invalid/recent$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"recent"}'
    - match: ^http://po0-report\.invalid/report$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"report"}'
    - match: ^http://po0-report\.invalid/toggle-official-timer$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"toggle-official-timer"}'
    - match: ^http://po0-report\.invalid/official-force$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force","channel":"official"}'
