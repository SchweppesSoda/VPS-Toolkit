name: PO0 LAN Worker 上报（正式）
desc: |-
  默认保留 LAN Worker；官方 Token 必须填写 pgnfw_xxxx 整段，支持 pgnfw_xxxx@0 到 @4（界面槽位 1–5）。同一目标的不同设备请使用不同槽位。
  官方通道每 10 分钟只读检查，必要时直连加白；LAN Worker 的 IP/网络变化和一小时续期规则保持原样。
  两路在同一次唤醒中按“官方先、Worker 后”执行，例行成功安静；Tile 只显示脱敏状态。
  点击状态 Tile 或访问 http://po0-report.invalid/status 只读检查（不会加白）；访问 /report-now 才是手动上报，仍会先 GET 再按需加白。
  Worker 按原方式填写参数；官方配置保存后按本机值运行，同步来的模块参数不会覆盖本机 Token/槽位。
  修改本机官方配置：在 /save-official 对应 argument 中填写完整 Token（可带 @槽位），再访问 http://po0-report.invalid/save-official；清除用 /clear-official。

script-providers:
  po0-stash-report-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/stash/po0-stash-report.js?rev=20260905-v6
    interval: 86400
  po0-stash-status-tile-v2:
    interval: 86400
    payload: |
      const key = "proxyconfig.po0.stash-report.v1";
        const statusUrl = "http://po0-report.invalid/status";
      const clean = (value, limit) => String(typeof value === "string" || typeof value === "number" ? value : "-").replace(/pgnfw_[A-Za-z0-9._~-]+/g, "[REDACTED]").replace(/Bearer\s+[^\s,;]+/gi, "Bearer [REDACTED]").replace(/\s+/g, " ").slice(0, limit);
      let state = {};
      try { state = JSON.parse($persistentStore.read(key) || "{}") || {}; } catch (_) {}
        const official = state.official && Array.isArray(state.official.accounts) ? state.official : {};
        const officialAccounts = Array.isArray(official.accounts) ? official.accounts : [];
        const officialOk = officialAccounts.filter((item) => item.status !== "error").length;
        const officialMissing = officialAccounts.filter((item) => item.status === "missing" || item.status === "slot-mismatch").length;
        const officialText = officialAccounts.length
          ? `官方 ${officialOk}/${officialAccounts.length}${officialMissing ? ` · 未命中 ${officialMissing}` : ""}`
          : "官方未启用";
        const acceptedAt = Number(state.accepted_at);
        if (!Number.isFinite(acceptedAt) || acceptedAt <= 0) {
          $done({
          title: officialAccounts.length && !official.last_error ? "PO0 官方状态" : "PO0 v2 未上报",
          content: `${officialText}\n${clean(state.last_error || "等待首次定时任务", 80)}`,
          icon: "antenna.radiowaves.left.and.right",
          backgroundColor: "#6b7280",
          url: statusUrl,
        });
      } else {
        const expiresAt = Number(state.expires_at);
        const remaining = Number.isFinite(expiresAt)
          ? Math.max(0, Math.min(99999, Math.floor((expiresAt * 1000 - Date.now()) / 60000)))
          : 0;
        const age = Math.max(0, Math.min(99999, Math.floor((Date.now() - acceptedAt * 1000) / 60000)));
        const cidr = clean(state.accepted_cidr || state.ip, 45);
        const error = state.last_error ? clean(state.last_error, 80) : "";
        $done({
          title: error ? "PO0 v2 上报异常" : remaining > 0 ? "PO0 v2 已上报" : "PO0 v2 已过期",
          content: error ? `${cidr}\n${error}\n${officialText}` : `${cidr}\n${clean(state.network, 12)} · ${age} 分钟前 · 剩余 ${remaining} 分钟\n${officialText}`,
          icon: error || remaining <= 0 ? "exclamationmark.triangle.fill" : "checkmark.shield.fill",
          backgroundColor: error || remaining <= 0 ? "#b45309" : "#178f55",
          url: statusUrl,
        });
      }

cron:
  script:
    - name: po0-stash-report-worker-v2
      cron: '*/10 * * * *'
      timeout: 90
      argument: '{"mode":"auto","worker_url":"https://CHANGE_ME/stash-report/v1","source_id":"iphone-stash","secret":"CHANGE_ME_BEARER","selected_proxy":"DIRECT","PO0_FIREWALL_TOKENS":""}'

tiles:
  - name: po0-stash-status-tile-v2
    interval: 600
    title: PO0 v2 未上报
    content: 等待首次定时任务
    icon: antenna.radiowaves.left.and.right
    backgroundColor: '#6b7280'
    url: http://po0-report.invalid/status

http:
  force-http-engine:
    - po0-report.invalid:80
  script:
    - match: ^http://po0-report\.invalid/report-now(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force","worker_url":"https://CHANGE_ME/stash-report/v1","source_id":"iphone-stash","secret":"CHANGE_ME_BEARER","selected_proxy":"DIRECT","PO0_FIREWALL_TOKENS":""}'
    - match: ^http://po0-report\.invalid/status(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"status","worker_url":"https://CHANGE_ME/stash-report/v1","source_id":"iphone-stash","secret":"CHANGE_ME_BEARER","selected_proxy":"DIRECT","PO0_FIREWALL_TOKENS":""}'

    - match: ^http://po0-report\.invalid/save-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"save-official","PO0_FIREWALL_TOKENS":""}'
    - match: ^http://po0-report\.invalid/clear-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"clear-official"}'
