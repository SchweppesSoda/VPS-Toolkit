name: PO0 防火墙
desc: |-
  「第三方服务」显示本机已放行的账号数。点开只读结果可查看官方出口和槽位。手动上报和账号管理见 http://po0-report.invalid/settings。
  【官方防火墙】只在 /save-official 参数填写 Token / 槽位和名称，然后访问 /save-official 保存。
  可以停用、恢复、清除或立即上报；停用保留参数，清除后同步参数不会自动恢复。
  账号可写为 Token@0|名称，多行用英文分号或换行分隔；旧版 Token 和独立名称列表仍可用。
  Stash 5 切网时核对官方白名单。定期检查默认每 600 秒执行一次；关闭开关保留原间隔，旧值 0 继续表示关闭。
  按网络选择默认关闭；将 /save-official 的 OFFICIAL_NETWORK_TARGETS_ENABLED 设为 true 并填写 PO0_FIREWALL_WIFI_TOKENS 后保存。
  开启后原目标用于蜂窝（5G/4G），Wi-Fi 使用另填的目标；沿用 Token 列表写法，槽位由你填写。
  /recent 查看最近结果，/status 查询官方白名单；/report 立即上报，/report-now 强制官方上报；官方始终先 GET，缺失时才加白。
  Stash 5 本机读取网络。SKIP_WIFI_SSIDS 用英文分号分隔并区分大小写。命中时跳过普通上报，强制上报可绕过；/status 始终只读。

# 旧版分网探测，仅供缺少 Stash 5 控制接口的客户端选择账号。
proxy-groups:
  - name: 📡 PO0 Wi-Fi 探测
    type: select
    icon: https://raw.githubusercontent.com/Orz-3/mini/master/Color/Urltest.png
    proxies: [REJECT, DIRECT]
    ssid-policy:
      default: DIRECT
      cellular: REJECT
  - name: 📡 PO0 蜂窝探测
    type: select
    icon: https://raw.githubusercontent.com/Orz-3/mini/master/Color/Urltest.png
    proxies: [REJECT, DIRECT]
    ssid-policy:
      default: REJECT
      cellular: DIRECT

script-providers:
  po0-stash-report-worker-v2:
    url: https://raw.githubusercontent.com/SchweppesSoda/VPS-Toolkit/main/scripts/po0/nftables/clients/stash/po0-firewall.js?rev=20261126-panel
    interval: 86400
  po0-stash-status-tile-v6:
    interval: 86400
    payload: |
      const key = "proxyconfig.po0.stash-report.v1";
      function read(key) {
        try { return JSON.parse($persistentStore.read(key)) || {}; } catch { return {}; }
      }
      // BEGIN GENERATED PO0 PANEL
      function panelOverview(state, settings) {
        const data = state.official || {};
        const accounts = Array.isArray(data.accounts) ? data.accounts.map(a => a && typeof a === 'object' && !Array.isArray(a) ? a : {}) : [];
        const total = accounts.length;
        const count = status => accounts.filter(a => a.status === status).length;
        const hits = count('ok'), failed = count('error'), missing = count('missing'), mismatch = count('slot-mismatch');
        const pending = total - hits - failed - missing - mismatch;
        const unconfigured = state.notice === '尚未配置账号';
        let headline = '等待首次检查', tone = 'idle';
        if (total && hits === total) { headline = data.last_error ? '检查有异常' : '全部放行'; tone = data.last_error ? 'warn' : 'good'; }
        else if (hits) { headline = '部分放行'; tone = 'warn'; }
        else if ((failed && failed === total) || (!total && data.last_error)) { headline = '检查失败'; tone = 'bad'; }
        else if (missing && missing === total) { headline = '均未放行'; tone = 'warn'; }
        else if (total) { headline = '尚未确认放行'; tone = 'warn'; }
        else if (unconfigured) headline = '尚未配置账号';

        const issues = [[failed, '检查失败'], [missing, '未放行'], [mismatch, '槽位不匹配'], [pending, '待确认']]
          .filter(([n]) => n).map(([n, label]) => n + ' 个' + label);
        if (data.last_error && !failed && total) issues.push('检查有异常');
        const tally = hits + '/' + total + ' 个账号已放行';
        let result = headline;
        if (hits) result = tally;
        else if (total && failed === total) result = total + ' 个账号检查失败';
        else if (total && missing === total) result = total + ' 个账号未放行';
        else if (total) result = total + ' 个账号尚未确认放行';
        const network = data.network === 'wifi' ? 'Wi-Fi' : data.network === 'cellular' ? '蜂窝' : '';
        function localTime(seconds) {
          const date = new Date(Number(seconds) * 1000);
          if (!(date.getTime() > 0)) return '';
          const today = new Date(Date.now());
          const day = date.getDate(), month = date.getMonth() + 1;
          const year = date.getFullYear() === today.getFullYear() ? '' : date.getFullYear() + '/';
          return (date.toDateString() === today.toDateString() ? '' : year + month + '/' + day + ' ') + date.toTimeString().slice(0, 5);
        }
        const context = [network, localTime(data.last_checked_at)].filter(Boolean).join(' ');
        const hasResult = Boolean(total || data.last_error);
        const runError = state.last_error && state.last_error !== data.last_error && state.last_error_at > 0
          && !(Number(data.last_checked_at) > Number(state.last_error_at));
        let notice = state.notice === 'Wi-Fi 已跳过' ? state.notice : state.notice === '网络类型未知' ? '网络未知，已跳过' : '';
        const noticeTime = localTime(notice ? state.notice_at : runError ? state.last_error_at : 0);
        if (runError && !notice) notice = '本次检查失败';
        if (settings.officialAutoEnabled === false && !unconfigured) notice = [notice, '自动上报已停用'].filter(Boolean).join(' · ');
        const style = {
          good: ['checkmark.shield.fill', '#187548'], warn: ['exclamationmark.shield.fill', '#a25b13'],
          bad: ['xmark.shield.fill', '#aa3a38'], idle: ['shield', '#6b7280'],
        };
        let [icon, backgroundColor] = style[tone];
        if (notice) {
          icon = notice.startsWith('本次检查失败') ? style.bad[0] : notice.startsWith('自动') ? 'pause.circle.fill' : 'clock.fill';
          backgroundColor = notice.startsWith('本次检查失败') ? style.bad[1] : style.idle[1];
        }
        const detail = !notice && total && failed !== total && missing !== total ? issues[0] : '';
        const summary = notice ? hasResult ? '上次 ' + result : '尚无上次结果' : result;
        const breakdown = hits ? [tally, ...issues].join(' · ') : issues.join(' · ');
        return { accounts, headline, tone, breakdown, context, notice, noticeTime, hasResult,
          tile: { title: 'PO0 防火墙 · 本机', content: [notice, summary, detail, hasResult && context].filter(Boolean).join(' · '),
            icon, backgroundColor, url: 'http://po0-report.invalid/recent' } };
      }
      // END GENERATED PO0 PANEL
      $done(panelOverview(read(key), read(key + ".channel-settings")).tile);


# ── 公共自动触发 · 读取本机官方配置 ──
event:
  script:
    - name: po0-stash-report-worker-v2
      event: network-changed
      timeout: 90
      argument: '{"mode":"auto","trigger":"network"}'

cron:
  script:
    - name: po0-stash-report-worker-v2
      cron: '* * * * *'
      timeout: 90
      argument: '{"mode":"auto"}'

tiles:
  - name: po0-stash-status-tile-v6
    collapsed: true
    interval: 600
    title: PO0 防火墙 · 本机
    content: 等待首次检查
    icon: shield
    backgroundColor: '#6b7280'
    url: http://po0-report.invalid/recent

http:
  force-http-engine:
    - po0-report.invalid:80
  script:
    - match: ^http://po0-report\.invalid/report-now(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force"}'
    - match: ^http://po0-report\.invalid/status(?:\?.*)?$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"status"}'

    # ── 官方防火墙参数 · 仅在这里填写 Token / 槽位 ──
    # 上报间隔默认 600 秒，可改为 60..86400；独立定期开关关闭后保留间隔与切网触发；保存不发起上报。
    # script-providers.interval 为脚本更新间隔；cron 每分钟在本机判断是否到期。
    - match: ^http://po0-report\.invalid/save-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"save-official","SKIP_WIFI_SSIDS":"","NOTIFY_SUCCESS":false,"NOTIFY_FAILURE":true,"PO0_FIREWALL_TOKENS":"","PO0_FIREWALL_NAMES":"","official_report_interval_seconds":600,"official_timer_enabled":true,"OFFICIAL_NETWORK_TARGETS_ENABLED":false,"PO0_FIREWALL_WIFI_TOKENS":"","PO0_FIREWALL_WIFI_NAMES":""}'
    - match: ^http://po0-report\.invalid/clear-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"clear-official"}'

    # ── 官方与公共操作 ──
    - match: ^http://po0-report\.invalid/toggle-official$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"toggle-official"}'
    - match: ^http://po0-report\.invalid/official-now$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"report","channel":"official"}'
    - match: ^http://po0-report\.invalid/settings$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"settings"}'
    - match: ^http://po0-report\.invalid/recent$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"recent"}'
    - match: ^http://po0-report\.invalid/report$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"report"}'
    - match: ^http://po0-report\.invalid/toggle-official-timer$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 10
      argument: '{"mode":"toggle-official-timer"}'
    - match: ^http://po0-report\.invalid/official-force$
      name: po0-stash-report-worker-v2
      type: request
      timeout: 90
      argument: '{"mode":"force","channel":"official"}'
